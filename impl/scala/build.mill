//| mill-version: 1.1.8
package build

import mill.*, scalalib.*

/** Scala implementation of the ILS risk conformance spec, v1.0.
  *
  * Independent of impl/python: shares only the case corpus (spec SS 6.2).
  */
object `package` extends ScalaModule {
  def scalaVersion = "3.9.0-RC6"

  def mvnDeps = Seq(
    mvn"com.lihaoyi::upickle:4.1.0",
    mvn"com.lihaoyi::os-lib:0.11.4",
    mvn"io.github.quafadas::vecxt:0.0.41"
  )

  def scalacOptions = Seq("-deprecation", "-feature", "-Wunused:all")

  // The corpus lives two levels up, outside this build. Both `run` and `test`
  // fork a JVM whose working directory is a Mill task dest, not the repo root,
  // so the root has to be passed explicitly. Deriving it from the workspace
  // rather than reading it from the ambient environment also means it does not
  // depend on what the Mill server was started with.
  private def conformanceRoot: String =
    (mill.api.BuildCtx.workspaceRoot / os.up / os.up).toString

  def forkEnv = super.forkEnv() + ("CONFORMANCE_ROOT" -> conformanceRoot)

  object test extends ScalaTests, TestModule.Munit {
    def mvnDeps = Seq(mvn"org.scalameta::munit:1.3.5")

    // `super` here is ScalaTests, not the enclosing module, so this repeats the
    // binding rather than inheriting it.
    def forkEnv = super.forkEnv() + ("CONFORMANCE_ROOT" -> conformanceRoot)
  }
}
